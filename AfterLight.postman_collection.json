              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deceasedInfo\": {\n    \"firstName\": \"Robert\",\n    \"middleName\": \"James\",\n    \"lastName\": \"Smith\",\n    \"dateOfBirth\": \"1945-06-15\",\n    \"dateOfDeath\": \"2026-02-28\",\n    \"placeOfDeath\": \"Chicago, IL\",\n    \"socialSecurityNumber\": \"123-45-6789\"\n  }\n}",
