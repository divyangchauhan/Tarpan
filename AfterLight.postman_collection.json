    {
      "name": "Documents",
      "item": [
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/cases/{{case_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cases", "{{case_id}}", "documents"]
            },
            "description": "List all documents for a case."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/cases/{{case_id}}/documents",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "cases", "{{case_id}}", "documents"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": \"d1e2f3a4-b5c6-7890-abcd-ef1234567890\",\n    \"caseId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n    \"fileName\": \"death-certificate.pdf\",\n    \"contentType\": \"application/pdf\",\n    \"status\": \"UPLOADED\",\n    \"extractedData\": null,\n    \"createdAt\": \"2026-03-12T10:05:00.000Z\",\n    \"updatedAt\": \"2026-03-12T10:05:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Initiate Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.documentId) {",
                  "  pm.collectionVariables.set('document_id', res.documentId);",
                  "  console.log('document_id saved: ' + res.documentId);",
                  "}",
                  "if (res.uploadUrl) {",
                  "  console.log('Pre-signed S3 upload URL: ' + res.uploadUrl);",
                  "  console.log('PUT this URL directly with the file binary — no auth header needed.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{case_id}}\",\n  \"fileName\": \"death-certificate.pdf\",\n  \"contentType\": \"application/pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/cases/{{case_id}}/documents/initiate-upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "cases", "{{case_id}}", "documents", "initiate-upload"]
            },
            "description": "Step 1 of 2 for uploading a document.\n\nReturns a pre-signed S3 URL. Use the `uploadUrl` from the response to PUT the file directly to S3 (no auth header on that PUT).\n\nOn success, `document_id` is automatically saved to collection variables.\n\nSupported `contentType` values: `application/pdf`, `image/jpeg`, `image/png`, `image/tiff`."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{access_token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"caseId\": \"{{case_id}}\",\n  \"fileName\": \"death-certificate.pdf\",\n  \"contentType\": \"application/pdf\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/cases/{{case_id}}/documents/initiate-upload",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "cases", "{{case_id}}", "documents", "initiate-upload"]
                }
              },
              "status": "Created",
              "code": 201,
              "body": "{\n  \"documentId\": \"d1e2f3a4-b5c6-7890-abcd-ef1234567890\",\n  \"uploadUrl\": \"https://afterlight-uploads.s3.amazonaws.com/cases/a1b2c3d4/death-certificate.pdf?X-Amz-Algorithm=AWS4-HMAC-SHA256&...\",\n  \"expiresIn\": 900\n}"
            }
          ]
        },
        {
          "name": "Upload File to S3 (Pre-signed PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/pdf",
                "description": "Must match the contentType used in Initiate Upload"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": {
              "raw": "PASTE_UPLOAD_URL_FROM_INITIATE_UPLOAD_RESPONSE",
