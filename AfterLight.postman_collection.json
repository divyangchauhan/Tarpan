                  "raw": "{\n  \"deceasedInfo\": {\n    \"firstName\": \"Robert\",\n    \"middleName\": \"James\",\n    \"lastName\": \"Smith\",\n    \"dateOfBirth\": \"1945-06-15\",\n    \"dateOfDeath\": \"2026-02-28\",\n    \"placeOfDeath\": \"Chicago, IL\",\n    \"socialSecurityNumber\": \"123-45-6789\"\n  }\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/cases",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "cases"]
                }
              },
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"status\": \"ACTIVE\",\n  \"deceasedInfo\": {\n    \"firstName\": \"Robert\",\n    \"middleName\": \"James\",\n    \"lastName\": \"Smith\",\n    \"dateOfBirth\": \"1945-06-15\",\n    \"dateOfDeath\": \"2026-02-28\",\n    \"placeOfDeath\": \"Chicago, IL\"\n  },\n  \"createdAt\": \"2026-03-12T10:00:00.000Z\",\n  \"updatedAt\": \"2026-03-12T10:00:00.000Z\"\n}"
