{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@afterlight/shared": ["../../packages/shared/src"],
      "@api/*": ["./src/*"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true
  },
  "include": ["src", "../../packages/shared/src"],
  "exclude": ["node_modules", "dist", "test"]
}
