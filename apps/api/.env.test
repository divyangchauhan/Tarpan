# E2E test environment — used by test/setup.ts
# Requires: docker compose up -d (PostgreSQL on localhost:5432)

PORT=3002
NODE_ENV=test
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://afterlight:afterlight@localhost:5432/afterlight_test

JWT_SECRET=test-jwt-secret-for-e2e-do-not-use-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-jwt-refresh-secret-for-e2e-do-not-use-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# Shared secret used by InternalSecretGuard
INTERNAL_API_SECRET=test-internal-secret

# AWS — real clients are mocked in tests; these values satisfy ConfigService validators
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_UPLOADS_BUCKET=afterlight-uploads-test
S3_GENERATED_DOCS_BUCKET=afterlight-generated-docs-test
SQS_DOCUMENT_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/afterlight-document-processing
SQS_DOCUMENT_GENERATION_QUEUE_URL=http://localhost:4566/000000000000/afterlight-document-generation

ANTHROPIC_API_KEY=test-key-not-used-in-e2e
