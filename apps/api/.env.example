# Application
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Database
DATABASE_URL=postgresql://tarpan:tarpan@localhost:5432/tarpan

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-use-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# S3
S3_UPLOADS_BUCKET=tarpan-uploads
S3_GENERATED_DOCS_BUCKET=tarpan-generated-docs

# SQS
SQS_DOCUMENT_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/tarpan-document-processing
SQS_DOCUMENT_GENERATION_QUEUE_URL=http://localhost:4566/000000000000/tarpan-document-generation

# Internal service auth (used by Lambda to call back to API)
INTERNAL_API_SECRET=change-me-in-production

# SSN encryption at rest (P6-09) — base64-encoded 32-byte AES-256 key.
# Generate with: openssl rand -base64 32
SSN_ENCRYPTION_KEY=change-me-base64-32-byte-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
